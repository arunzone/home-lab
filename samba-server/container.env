# Desired state of LXC 100 (samba-server).
# Workflow: edit this file -> commit -> ./apply.sh --check -> ./apply.sh
# Values below match the live config as of 2026-10-13, so the first apply only
# fixes real drift (stopped container, missing onboot).

CTID=100
CT_HOSTNAME=samba-server

# --- Network -----------------------------------------------------------------
# vmbr1 = nic0 (dedicated port). vmbr0 = nic1, the bridge media-manager uses.
# If apply.sh reports 192.168.1.100 unreachable, switch to BRIDGE=vmbr0 IFACE=eth0.
BRIDGE=vmbr1
IFACE=eth1
IP=192.168.1.100/24
GW=192.168.1.1
HWADDR=BC:24:11:17:FA:EA   # keep fixed so DHCP reservations / ARP caches stay valid
FIREWALL=1

# --- Lifecycle ---------------------------------------------------------------
ONBOOT=1                   # start with the Proxmox host

# --- Storage -----------------------------------------------------------------
MP0="/mnt/storage,mp=/mnt/media"   # same 16TB drive media-manager mounts

# --- Sizing ------------------------------------------------------------------
# Used on create. On an existing container they are enforced only when set;
# blank = not managed. Fill them from `pct config 100`, then run --check.
CORES=
MEMORY=
SWAP=

# --- Users inside the container ----------------------------------------------
# smb.conf forces every file on the Media share to this user/group.
# UID/GID drift is reported but never auto-fixed: changing them re-owns files on /mnt/media.
MEDIA_USER=media
MEDIA_UID=1000
MEDIA_GID=1000
# Samba login accounts (space-separated). Passwords are never stored in git:
# set SMB_PASSWORD in the environment only when apply.sh must create an account.
SMB_USERS="media"

# --- Create-only (cannot change after the container exists) -------------------
ROOTFS_STORAGE=local-lvm
ROOTFS_GB=8
UNPRIVILEGED=0
TEMPLATE_MATCH=debian-12
